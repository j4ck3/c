# Copy to .env and fill in. Do not commit .env.

# Cursor: https://cursor.com/dashboard/api
# Prefer this for headless auth. Alternative: docker exec -it t3code agent login
CURSOR_API_KEY=

# GitHub: https://github.com/settings/tokens (repo scope) or `gh auth login`
GH_TOKEN=

# Git identity for commits made by the agent
GIT_AUTHOR_NAME=jacob
GIT_AUTHOR_EMAIL=you@example.com

# Context7 MCP (used by deepseek-harness): https://context7.com/dashboard
# CONTEXT7_API_KEY=
