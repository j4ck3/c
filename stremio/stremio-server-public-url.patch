diff --git a/internal/media/hls.go b/internal/media/hls.go
index 357d271..284b1cf 100644
--- a/internal/media/hls.go
+++ b/internal/media/hls.go
@@ -290,10 +290,23 @@ func newHLS() *hlsManager {
 	return m
 }
 
-// localize rewrites the self-signed https loopback URL to plain http so ffmpeg
-// (which doesn't ignore TLS errors) can read the stream.
+// localize rewrites media URLs so ffprobe/ffmpeg can read them from inside the
+// server process. Public HTTPS hostnames often fail under VPN DNS / hairpin
+// NAT; map STREMIO_PUBLIC_URL back to the local HTTP listener instead.
 func localize(u string) string {
-	return strings.ReplaceAll(u, "https://127.0.0.1:12470", "http://127.0.0.1:11470")
+	u = strings.ReplaceAll(u, "https://127.0.0.1:12470", "http://127.0.0.1:11470")
+	publicURL := strings.TrimRight(os.Getenv("STREMIO_PUBLIC_URL"), "/")
+	if publicURL == "" {
+		publicURL = strings.TrimRight(os.Getenv("STREMIO_PROXY_PUBLIC_URL"), "/")
+	}
+	if publicURL != "" && (u == publicURL || strings.HasPrefix(u, publicURL+"/")) {
+		local := "http://127.0.0.1:11470"
+		if port := strings.TrimSpace(os.Getenv("HTTP_PORT")); port != "" {
+			local = "http://127.0.0.1:" + port
+		}
+		u = local + strings.TrimPrefix(u, publicURL)
+	}
+	return u
 }
 
