# DeepSeek Harness Web UI on Netbird
#
# Reachable at https://code.netbird.hjacke.com (dockhand-netbird-proxy).
# Filesystem, Docker, and LAN access mirror the t3code dev environment.

x-default: &default
  restart: unless-stopped
  logging:
    driver: json-file
    options:
      max-size: "50m"
      max-file: "3"

services:
  # Macvlan (br0_docker) cannot reach the Unraid host IP (10.0.0.24). Bridge
  # networks can. This proxy lets Host `tower` work from deepseek-harness.
  tower-ssh-proxy:
    <<: *default
    image: alpine/socat:1.8.0.0
    container_name: tower-ssh-proxy
    command: ["TCP-LISTEN:22,fork,reuseaddr", "TCP:10.0.0.24:22"]
    networks:
      - npm_services

  deepseek-harness:
    <<: *default
    build:
      context: .
      dockerfile: Dockerfile
      args:
        DSH_VERSION: ${DSH_VERSION:-0.1.2-rc.1}
    image: deepseek-harness:local
    container_name: deepseek-harness
    hostname: deepseek-harness
    init: true
    # Root only long enough to publish a readable copy of Unraid's 0600 SSH
    # config; entrypoint then drops to uid 1000 (see entrypoint.sh).
    user: "0:0"
    group_add:
      - "281"
    # Root entrypoint installs one host route, then drops all effective
    # capabilities before starting DSH as uid 1000.
    cap_add:
      - NET_ADMIN
    depends_on:
      - tower-ssh-proxy
    env_file:
      - path: ../t3code/.env
        required: false
    environment:
      - HOME=/home/t3
      - DSH_HOME=/home/t3/.dsh
      # Must stay unset. NODE_ENV=production makes npm omit devDependencies.
      - TRUSTED_HOST=${TRUSTED_HOST:-code.netbird.hjacke.com}
      - DSH_PORT=13080
      - PROXY_PORT=3080
      # Recreate Unraid's volatile /root Agent Host link from persistent cache
      # storage before DSH starts. Space-separated targets are supported.
      - DSH_REMOTE_VSCODE_HOSTS=${DSH_REMOTE_VSCODE_HOSTS:-tower}
      # br0_docker is macvlan: its children cannot reach the parent host at
      # 10.0.0.24. Route only Tower itself through the normal Docker bridge.
      - TOWER_HOST_IP=10.0.0.24
      - TOWER_HOST_ROUTE_VIA=172.25.0.1
      # Nested OS sandbox cannot run here (no Landlock, no bwrap userns).
      # The container is the isolation boundary; skip in-process confinement.
      - DSH_PERMISSION_MODE=danger-full-access
      # The OpenViking memory bundle resolves this endpoint plus the generated
      # per-harness ovcli.conf (created by entrypoint from the read-only source).
      - OPENVIKING_URL=http://openviking:1933
      # Keep automatic recall scoped to the active workspace peer so projects
      # never borrow one another's memory context.
      - OPENVIKING_RECALL_PEER_SCOPE=actor
      - DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY:-}
      - CONTEXT7_API_KEY=${CONTEXT7_API_KEY:-}
      - CURSOR_API_KEY=${CURSOR_API_KEY:-}
      - GH_TOKEN=${GH_TOKEN:-}
      - GITHUB_TOKEN=${GITHUB_TOKEN:-}
      - GIT_AUTHOR_NAME=${GIT_AUTHOR_NAME:-jacob}
      - GIT_AUTHOR_EMAIL=${GIT_AUTHOR_EMAIL:-jacobhallgren@live.se}
      - GIT_COMMITTER_NAME=${GIT_AUTHOR_NAME:-jacob}
      - GIT_COMMITTER_EMAIL=${GIT_AUTHOR_EMAIL:-jacobhallgren@live.se}
    volumes:
      # Shared t3code home: git/gh/ssh credentials and agent config.
      - /mnt/user/appdata/t3code/home:/home/t3
      - /mnt/user/documents/compose:/home/t3/compose
      - /mnt/user/documents/dev:/home/t3/dev
      - /mnt/user/documents/work:/home/t3/work
      - /mnt/user/documents/projects:/home/t3/projects
      - /mnt/user/documents/compose:/workspace/compose
      - /mnt/user/documents/dev:/workspace/dev
      - /mnt/user/documents/work:/workspace/work
      - /mnt/user/documents/projects:/workspace/projects
      # Unraid OpenSSH user config (flash: /root/.ssh -> /boot/config/ssh/root).
      # vfat 0600 is unreadable as uid 1000; entrypoint copies it to ssh_config.d.
      - /root/.ssh/config:/mnt/unraid-ssh/config:ro
      # The entrypoint copies only the agent API key (never the root key) into
      # the t3 home with node-readable permissions.
      - /mnt/user/appdata/openviking/ovcli.conf:/mnt/openviking/ovcli.conf:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - /etc/localtime:/etc/localtime:ro
    working_dir: /workspace
    expose:
      - "3080"
    # Pi-hole is 172.44.0.2 on dns_net. Without a static address here, a
    # restart race lets this container steal .2 and DNS (model API calls) dies.
    dns:
      - 172.44.0.2
    networks:
      npm_services:
      dns_net:
        ipv4_address: 172.44.0.27
      br0_docker:
        ipv4_address: 10.0.0.27

networks:
  npm_services:
    external: true
  dns_net:
    external: true
    name: dns_dns_net
  br0_docker:
    external: true
