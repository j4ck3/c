# Optional overrides for DeepSeek Harness
# DEEPSEEK_API_KEY=sk-...
# CONTEXT7_API_KEY=  # https://context7.com/dashboard — optional, higher rate limits
# DSH_VERSION=0.1.6-alpha.2
# TRUSTED_HOST=code.netbird.hjacke.com
#
# OpenDesign (https://design.netbird.hjacke.com)
# OPEN_DESIGN_IMAGE=ghcr.io/nexu-io/od:0.24.0
# OPEN_DESIGN_REF=open-design-v0.24.0
# OPEN_DESIGN_DSH_VERSION=0.1.7-rc.1
# OPEN_DESIGN_ALLOWED_ORIGINS=https://design.netbird.hjacke.com
# OPEN_DESIGN_MEM_LIMIT=1g
# OD_API_TOKEN=  # Generate with: openssl rand -hex 32
#
# Nested sandbox (bwrap/Landlock) cannot run in this Unraid container.
# DSH_PERMISSION_MODE=danger-full-access is set in compose.yml on purpose.
#
# Git/GitHub credentials are inherited from ../t3code/.env when present.
