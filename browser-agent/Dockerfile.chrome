# Headed Chromium on a virtual X display, viewable through noVNC.
# Headed mode passes bot checks (hCaptcha) far more often than --headless, and noVNC
# lets a human take over for captchas or 2FA prompts.
ARG BROWSER_USE_TAG=main
FROM browseruse/browseruse:${BROWSER_USE_TAG}
USER root
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends xvfb x11vnc novnc websockify fluxbox \
    && rm -rf /var/lib/apt/lists/*
COPY chrome-entrypoint.sh /usr/local/bin/chrome-entrypoint.sh
RUN chmod 0755 /usr/local/bin/chrome-entrypoint.sh
USER browseruse
ENTRYPOINT ["/usr/local/bin/chrome-entrypoint.sh"]
